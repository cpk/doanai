# Copy file này thành .env rồi điền key của model đã chọn.
# (Tên biến sẽ được xác nhận lại theo tài liệu Midscene hiện hành — xem docs/pilot-model-cost.md)

# --- Phương án A: GPT-4o (OpenAI) ---
OPENAI_API_KEY=
MIDSCENE_MODEL_NAME=gpt-4o-2024-11-20

# --- Phương án B: Qwen2.5-VL (Alibaba DashScope, OpenAI-compatible) ---
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# MIDSCENE_MODEL_NAME=qwen2.5-vl-72b-instruct
# MIDSCENE_USE_QWEN_VL=1
